diff -ruN a/lib/utils/crop_sampler.dart b/lib/utils/crop_sampler.dart
--- a/lib/utils/crop_sampler.dart	1970-01-01 07:00:00.000000000 +0700
+++ b/lib/utils/crop_sampler.dart	2026-10-16 07:40:39.583865894 +0700
@@ -0,0 +1,68 @@
+import 'dart:typed_data';
+
+/// Sumber piksel dari gambar TEGAK (sudah diputar agar wajah tegak).
+/// Pemanggil menjamin koordinat (x, y) berada di dalam gambar.
+abstract class PixelSource {
+  int get width;
+  int get height;
+
+  /// Menulis nilai r, g, b (0..255) piksel (x, y) ke [rgb].
+  void read(int x, int y, Float64List rgb);
+}
+
+/// Mengambil kotak persegi ([left], [top], [side]) dari [src], lalu mengecilkannya
+/// ke [size] x [size] dengan interpolasi bilinear dan menormalisasi
+/// (piksel - [mean]) / [std] dalam urutan RGB, siap dimasukkan ke model.
+///
+/// Bagian kotak yang keluar dari gambar diisi nilai [mean], jadi menjadi 0 setelah normalisasi.
+Float32List sampleSquare(
+  PixelSource src,
+  double left,
+  double top,
+  double side,
+  int size,
+  double mean,
+  double std,
+) {
+  final out = Float32List(size * size * 3);
+  final step = side / size;
+  final w = src.width;
+  final h = src.height;
+  final p = Float64List(3);
+  int o = 0;
+
+  for (int j = 0; j < size; j++) {
+    final sy = top + (j + 0.5) * step - 0.5;
+    final y0 = sy.floor();
+    final fy = sy - y0;
+    for (int i = 0; i < size; i++) {
+      final sx = left + (i + 0.5) * step - 0.5;
+      final x0 = sx.floor();
+      final fx = sx - x0;
+
+      double r = 0, g = 0, b = 0;
+      for (int k = 0; k < 4; k++) {
+        final dx = k & 1;
+        final dy = k >> 1;
+        final x = x0 + dx;
+        final y = y0 + dy;
+        final wt = (dx == 0 ? 1 - fx : fx) * (dy == 0 ? 1 - fy : fy);
+        if (wt == 0) continue;
+        if (x >= 0 && y >= 0 && x < w && y < h) {
+          src.read(x, y, p);
+          r += wt * p[0];
+          g += wt * p[1];
+          b += wt * p[2];
+        } else {
+          r += wt * mean;
+          g += wt * mean;
+          b += wt * mean;
+        }
+      }
+      out[o++] = (r - mean) / std;
+      out[o++] = (g - mean) / std;
+      out[o++] = (b - mean) / std;
+    }
+  }
+  return out;
+}
diff -ruN a/lib/utils/face_embedder.dart b/lib/utils/face_embedder.dart
--- a/lib/utils/face_embedder.dart	1970-01-01 07:00:00.000000000 +0700
+++ b/lib/utils/face_embedder.dart	2026-10-16 07:40:39.583877120 +0700
@@ -0,0 +1,136 @@
+import 'dart:convert';
+import 'dart:math' as math;
+import 'dart:typed_data';
+import 'dart:ui' show Rect;
+
+import 'package:camera/camera.dart';
+import 'package:flutter/foundation.dart';
+import 'package:flutter/services.dart' show rootBundle;
+import 'package:image/image.dart' as img;
+import 'package:tflite_flutter/tflite_flutter.dart';
+
+import 'image_converter.dart';
+
+/// Pembungkus model embedding wajah (TFLite).
+///
+/// CARA GANTI MODEL: ganti DUA file di folder assets/ dengan hasil Colab
+///   - model_face_embedding.tflite
+///   - face_embedding_config.json   (threshold, ukuran crop, normalisasi)
+/// Ukuran input dan dimensi embedding dibaca otomatis dari model. Wajah yang sudah
+/// didaftarkan dengan model lama otomatis dianggap kedaluwarsa (lihat [modelVersion]).
+class FaceEmbedder {
+  FaceEmbedder._();
+  static final FaceEmbedder instance = FaceEmbedder._();
+
+  static const String modelAsset = 'assets/model_face_embedding.tflite';
+  static const String configAsset = 'assets/face_embedding_config.json';
+
+  Interpreter? _interpreter;
+  Future<void>? _loading;
+
+  /// Nilai di bawah ini ditimpa oleh isi face_embedding_config.json dan model.
+  int inputSize = 224;
+  int embeddingDim = 0;
+  double threshold = 0.66;
+  double inputMean = 127.5; // preprocessing: (piksel - mean) / std, urutan RGB
+  double inputStd = 127.5;
+  double cropScale = 2.2; // sisi crop = cropScale x sisi kotak wajah (LFW: 2,2x)
+  String modelVersion = '';
+
+  bool get isReady => _interpreter != null;
+
+  Future<void> ensureLoaded() {
+    return _loading ??= _load().catchError((Object e) {
+      _loading = null; // izinkan coba lagi
+      throw e;
+    });
+  }
+
+  Future<void> _load() async {
+    final cfg = jsonDecode(await rootBundle.loadString(configAsset)) as Map<String, dynamic>;
+    threshold = ((cfg['threshold'] ?? cfg['threshold_eer']) as num?)?.toDouble() ?? threshold;
+    inputMean = (cfg['input_mean'] as num?)?.toDouble() ?? inputMean;
+    inputStd = (cfg['input_std'] as num?)?.toDouble() ?? inputStd;
+    cropScale = (cfg['crop_scale'] as num?)?.toDouble() ?? cropScale;
+
+    final data = await rootBundle.load(modelAsset);
+    final bytes = data.buffer.asUint8List(data.offsetInBytes, data.lengthInBytes);
+    modelVersion = _fingerprint(bytes);
+
+    final options = InterpreterOptions()..threads = 2;
+    final interpreter = Interpreter.fromBuffer(bytes, options: options);
+
+    final inShape = interpreter.getInputTensor(0).shape;
+    final outShape = interpreter.getOutputTensor(0).shape;
+    if (inShape.length != 4 || inShape[3] != 3 || inShape[1] != inShape[2]) {
+      interpreter.close();
+      throw StateError('Bentuk input model tidak didukung: $inShape (butuh [1, N, N, 3])');
+    }
+    inputSize = inShape[1];
+    embeddingDim = outShape.last;
+    _interpreter = interpreter;
+    debugPrint('FaceEmbedder siap: input $inShape, output $outShape, threshold $threshold, versi $modelVersion');
+  }
+
+  /// Sidik jari ringan isi model, dipakai menandai embedding milik model yang mana.
+  static String _fingerprint(Uint8List b) {
+    int h = 0x811c9dc5;
+    h = ((h ^ b.length) * 0x01000193) & 0xFFFFFFFF;
+    for (int i = 0; i < b.length; i += 997) {
+      h = ((h ^ b[i]) * 0x01000193) & 0xFFFFFFFF;
+    }
+    return '${b.length}-${h.toRadixString(16)}';
+  }
+
+  /// [input]: Float32List sepanjang inputSize*inputSize*3 (RGB, sudah dinormalisasi).
+  /// Mengembalikan embedding yang sudah di-L2-normalize.
+  List<double> embed(Float32List input) {
+    final interpreter = _interpreter;
+    if (interpreter == null) throw StateError('FaceEmbedder belum dimuat');
+    final output = [List<double>.filled(embeddingDim, 0.0)];
+    interpreter.run(input.reshape([1, inputSize, inputSize, 3]), output);
+    return _l2Normalize(output[0]);
+  }
+
+  /// Embedding wajah dari frame kamera. [box] = kotak wajah ML Kit (koordinat gambar tegak),
+  /// [rotation] = rotasi (derajat) yang sama dengan yang diberikan ke ML Kit.
+  List<double>? embedCameraFace(CameraImage image, Rect box, int rotation) {
+    final input = FaceCropper.fromCameraImage(
+      image, box, rotation,
+      size: inputSize, scale: cropScale, mean: inputMean, std: inputStd,
+    );
+    return input == null ? null : embed(input);
+  }
+
+  /// Embedding wajah dari foto (sudah diputar tegak). [box] = kotak wajah ML Kit.
+  List<double> embedImageFace(img.Image upright, Rect box) {
+    final input = FaceCropper.fromImage(
+      upright, box,
+      size: inputSize, scale: cropScale, mean: inputMean, std: inputStd,
+    );
+    return embed(input);
+  }
+
+  static List<double> _l2Normalize(List<double> v) {
+    double s = 0;
+    for (final x in v) {
+      s += x * x;
+    }
+    final n = math.sqrt(s);
+    if (n == 0) return List<double>.from(v);
+    return [for (final x in v) x / n];
+  }
+
+  /// Cosine similarity (-1..1).
+  static double cosine(List<double> a, List<double> b) {
+    final n = math.min(a.length, b.length);
+    double dot = 0, na = 0, nb = 0;
+    for (int i = 0; i < n; i++) {
+      dot += a[i] * b[i];
+      na += a[i] * a[i];
+      nb += b[i] * b[i];
+    }
+    if (na == 0 || nb == 0) return 0;
+    return dot / (math.sqrt(na) * math.sqrt(nb));
+  }
+}
diff -ruN a/lib/utils/face_store.dart b/lib/utils/face_store.dart
--- a/lib/utils/face_store.dart	1970-01-01 07:00:00.000000000 +0700
+++ b/lib/utils/face_store.dart	2026-10-16 07:40:39.583831072 +0700
@@ -0,0 +1,126 @@
+import 'package:supabase_flutter/supabase_flutter.dart';
+
+import 'face_embedder.dart';
+
+/// Hasil pembacaan wajah terdaftar milik pengguna.
+class FaceProfile {
+  FaceProfile({
+    required this.userId,
+    required this.entries,
+    required this.embeddings,
+    required this.staleCount,
+  });
+
+  final String userId;
+
+  /// Entri JSON yang valid untuk model saat ini.
+  final List<Map<String, dynamic>> entries;
+
+  /// Embedding dari [entries] (urutan sama).
+  final List<List<double>> embeddings;
+
+  /// Entri lama: format sebelumnya atau dibuat dengan model lain, tidak bisa dibandingkan.
+  final int staleCount;
+}
+
+/// Baca/tulis embedding wajah di kolom profiles.face_embeddings (jsonb, berisi array).
+///
+/// Format satu entri:
+///   {"id": "...", "created_at": "...", "model": "<versi model>", "dim": 1024, "embedding": [..]}
+class FaceStore {
+  FaceStore._();
+
+  static const int minFaces = 3;
+  static const int maxFaces = 5;
+
+  static Future<Map<String, dynamic>?> _profileRow() async {
+    final supabase = Supabase.instance.client;
+    final uid = supabase.auth.currentUser?.id;
+    final query = supabase.from('profiles').select('id, face_embeddings');
+    if (uid != null) {
+      return await query.eq('id', uid).maybeSingle();
+    }
+    // Sama seperti layar lain: tanpa sesi login, pakai profil pertama (mode pengujian).
+    return await query.limit(1).maybeSingle();
+  }
+
+  static Future<FaceProfile> load() async {
+    await FaceEmbedder.instance.ensureLoaded();
+    final row = await _profileRow();
+    final raw = row?['face_embeddings'];
+
+    final entries = <Map<String, dynamic>>[];
+    final embeddings = <List<double>>[];
+    int stale = 0;
+    if (raw is List) {
+      for (final item in raw) {
+        final emb = _parse(item);
+        if (emb == null) {
+          stale++;
+        } else {
+          entries.add(Map<String, dynamic>.from(item as Map));
+          embeddings.add(emb);
+        }
+      }
+    }
+    return FaceProfile(
+      userId: row?['id']?.toString() ?? '',
+      entries: entries,
+      embeddings: embeddings,
+      staleCount: stale,
+    );
+  }
+
+  static List<double>? _parse(dynamic item) {
+    if (item is! Map) return null;
+    final embedder = FaceEmbedder.instance;
+    if (item['model']?.toString() != embedder.modelVersion) return null;
+    final v = item['embedding'];
+    if (v is! List || v.length != embedder.embeddingDim) return null;
+    return [for (final x in v) (x as num).toDouble()];
+  }
+
+  /// Menambah satu embedding. Entri kedaluwarsa dibuang karena tidak bisa dipakai lagi.
+  /// Mengembalikan jumlah wajah valid setelah penambahan.
+  static Future<int> add(List<double> embedding) async {
+    final profile = await load();
+    if (profile.userId.isEmpty) throw Exception('Profil tidak ditemukan.');
+    if (profile.entries.length >= maxFaces) {
+      throw Exception('Maksimal $maxFaces wajah. Reset dulu untuk mengganti.');
+    }
+    final now = DateTime.now();
+    final entry = <String, dynamic>{
+      'id': now.microsecondsSinceEpoch.toString(),
+      'created_at': now.toUtc().toIso8601String(),
+      'model': FaceEmbedder.instance.modelVersion,
+      'dim': embedding.length,
+      'embedding': [for (final x in embedding) (x * 1e6).round() / 1e6],
+    };
+    final updated = [...profile.entries, entry];
+    await Supabase.instance.client
+        .from('profiles')
+        .update({'face_embeddings': updated})
+        .eq('id', profile.userId);
+    return updated.length;
+  }
+
+  /// Menghapus semua wajah terdaftar (termasuk entri lama).
+  static Future<void> clear() async {
+    final profile = await load();
+    if (profile.userId.isEmpty) throw Exception('Profil tidak ditemukan.');
+    await Supabase.instance.client
+        .from('profiles')
+        .update({'face_embeddings': <dynamic>[]})
+        .eq('id', profile.userId);
+  }
+
+  /// Kemiripan tertinggi antara [probe] dan semua embedding terdaftar.
+  static double bestMatch(List<double> probe, List<List<double>> enrolled) {
+    double best = -1;
+    for (final e in enrolled) {
+      final s = FaceEmbedder.cosine(probe, e);
+      if (s > best) best = s;
+    }
+    return best;
+  }
+}
diff -ruN a/lib/utils/image_converter.dart b/lib/utils/image_converter.dart
--- a/lib/utils/image_converter.dart	2026-10-16 07:35:31.057757493 +0700
+++ b/lib/utils/image_converter.dart	2026-10-16 07:40:39.583853369 +0700
@@ -0,0 +1,176 @@
+import 'dart:math' as math;
+import 'dart:typed_data';
+import 'dart:ui' show Rect;
+
+import 'package:camera/camera.dart';
+import 'package:image/image.dart' as img;
+
+import 'crop_sampler.dart';
+
+/// Memotong wajah dari frame kamera atau foto, lalu mengubahnya ke tensor input model.
+///
+/// Kotak wajah dari ML Kit diperlebar [scale] kali menjadi persegi supaya framing-nya
+/// mirip data latih LFW (wajah memenuhi sekitar 1/2,2 sisi gambar, rambut dan latar ikut terlihat).
+class FaceCropper {
+  FaceCropper._();
+
+  /// [faceBox] dalam koordinat gambar TEGAK (seperti yang dikembalikan ML Kit),
+  /// [rotationDegrees] = rotasi searah jarum jam untuk menegakkan frame (sama dengan yang diberikan ke ML Kit).
+  /// Mengembalikan null kalau format frame tidak didukung.
+  static Float32List? fromCameraImage(
+    CameraImage image,
+    Rect faceBox,
+    int rotationDegrees, {
+    required int size,
+    required double scale,
+    required double mean,
+    required double std,
+  }) {
+    final src = _CameraSource.create(image, rotationDegrees);
+    if (src == null) return null;
+    return _crop(src, faceBox, size, scale, mean, std);
+  }
+
+  /// [upright] = foto yang sudah tegak (setelah bakeOrientation), [faceBox] dalam koordinat foto itu.
+  static Float32List fromImage(
+    img.Image upright,
+    Rect faceBox, {
+    required int size,
+    required double scale,
+    required double mean,
+    required double std,
+  }) {
+    return _crop(_ImageSource(upright), faceBox, size, scale, mean, std);
+  }
+
+  static Float32List _crop(PixelSource src, Rect box, int size, double scale, double mean, double std) {
+    final side = math.max(box.width, box.height) * scale;
+    final c = box.center;
+    return sampleSquare(src, c.dx - side / 2, c.dy - side / 2, side, size, mean, std);
+  }
+}
+
+class _ImageSource implements PixelSource {
+  _ImageSource(this._image);
+  final img.Image _image;
+
+  @override
+  int get width => _image.width;
+
+  @override
+  int get height => _image.height;
+
+  @override
+  void read(int x, int y, Float64List rgb) {
+    final p = _image.getPixel(x, y);
+    rgb[0] = p.r.toDouble();
+    rgb[1] = p.g.toDouble();
+    rgb[2] = p.b.toDouble();
+  }
+}
+
+enum _Layout { nv21, yuv420, bgra }
+
+/// Membaca piksel TEGAK langsung dari frame mentah kamera, tanpa membuat gambar perantara.
+class _CameraSource implements PixelSource {
+  _CameraSource._(this._image, this._rotation, this._layout)
+      : _p0 = _image.planes[0].bytes,
+        _stride0 = _image.planes[0].bytesPerRow,
+        _p1 = _image.planes.length > 1 ? _image.planes[1].bytes : null,
+        _stride1 = _image.planes.length > 1 ? _image.planes[1].bytesPerRow : 0,
+        _pix1 = _image.planes.length > 1 ? (_image.planes[1].bytesPerPixel ?? 1) : 1,
+        _p2 = _image.planes.length > 2 ? _image.planes[2].bytes : null,
+        _stride2 = _image.planes.length > 2 ? _image.planes[2].bytesPerRow : 0,
+        _pix2 = _image.planes.length > 2 ? (_image.planes[2].bytesPerPixel ?? 1) : 1;
+
+  final CameraImage _image;
+  final int _rotation;
+  final _Layout _layout;
+  final Uint8List _p0;
+  final int _stride0;
+  final Uint8List? _p1;
+  final int _stride1;
+  final int _pix1;
+  final Uint8List? _p2;
+  final int _stride2;
+  final int _pix2;
+
+  static _CameraSource? create(CameraImage image, int rotation) {
+    if (image.planes.isEmpty) return null;
+    final rot = ((rotation % 360) + 360) % 360;
+    if (rot % 90 != 0) return null;
+
+    if (image.planes.length >= 3) {
+      return _CameraSource._(image, rot, _Layout.yuv420);
+    }
+    if (image.format.group == ImageFormatGroup.bgra8888) {
+      return _CameraSource._(image, rot, _Layout.bgra);
+    }
+    // NV21: satu plane berisi Y lalu V/U berselang-seling (ukuran total = stride * tinggi * 1,5)
+    final plane = image.planes[0];
+    if (plane.bytes.length < plane.bytesPerRow * image.height * 3 ~/ 2) return null;
+    return _CameraSource._(image, rot, _Layout.nv21);
+  }
+
+  bool get _swap => _rotation == 90 || _rotation == 270;
+
+  @override
+  int get width => _swap ? _image.height : _image.width;
+
+  @override
+  int get height => _swap ? _image.width : _image.height;
+
+  @override
+  void read(int ux, int uy, Float64List rgb) {
+    final w = _image.width;
+    final h = _image.height;
+
+    // Titik (ux, uy) pada gambar tegak -> titik (rx, ry) pada frame mentah.
+    int rx = ux;
+    int ry = uy;
+    switch (_rotation) {
+      case 90:
+        rx = uy;
+        ry = h - 1 - ux;
+        break;
+      case 180:
+        rx = w - 1 - ux;
+        ry = h - 1 - uy;
+        break;
+      case 270:
+        rx = w - 1 - uy;
+        ry = ux;
+        break;
+    }
+
+    switch (_layout) {
+      case _Layout.bgra:
+        final i = ry * _stride0 + rx * 4;
+        rgb[0] = _p0[i + 2].toDouble();
+        rgb[1] = _p0[i + 1].toDouble();
+        rgb[2] = _p0[i].toDouble();
+        break;
+      case _Layout.nv21:
+        final yNv = _p0[ry * _stride0 + rx].toDouble();
+        final uvNv = _stride0 * h + (ry >> 1) * _stride0 + (rx & ~1);
+        _yuvToRgb(yNv, _p0[uvNv + 1].toDouble(), _p0[uvNv].toDouble(), rgb); // urutan NV21: V lalu U
+        break;
+      case _Layout.yuv420:
+        final y420 = _p0[ry * _stride0 + rx].toDouble();
+        final u420 = _p1![(ry >> 1) * _stride1 + (rx >> 1) * _pix1].toDouble();
+        final v420 = _p2![(ry >> 1) * _stride2 + (rx >> 1) * _pix2].toDouble();
+        _yuvToRgb(y420, u420, v420, rgb);
+        break;
+    }
+  }
+
+  static void _yuvToRgb(double y, double u, double v, Float64List rgb) {
+    final uu = u - 128.0;
+    final vv = v - 128.0;
+    rgb[0] = _clamp255(y + 1.402 * vv);
+    rgb[1] = _clamp255(y - 0.344136 * uu - 0.714136 * vv);
+    rgb[2] = _clamp255(y + 1.772 * uu);
+  }
+
+  static double _clamp255(double v) => v < 0 ? 0 : (v > 255 ? 255 : v);
+}
